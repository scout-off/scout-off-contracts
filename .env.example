# ScoutChain Contracts — environment variables
# Copy to .env and fill in all values before deploying or running the backend.
#
# Variables are grouped by the component that consumes them.
# Required = the scripts / services will exit if the value is absent.
# Optional = a safe default exists or the feature is not exercised on testnet.

# =============================================================================
# Stellar / Soroban — deployment & contract invocation (scripts/deploy.sh,
# scripts/initialize.sh, scripts/generate-bindings.sh, testnet/seed.sh)
# =============================================================================

# Stellar secret key (S...) used to deploy contracts and sign transactions.
# REQUIRED for all deployment and initialization scripts.
DEPLOYER_SECRET=

# Stellar public G-address that will be set as admin on all four contracts.
# REQUIRED — ownership cannot be transferred after initialization.
# Must be a valid public key (G...). Never put a secret seed (S...) here —
# the backend rejects secret seeds and invalid addresses at startup.
ADMIN_ADDRESS=

# Secret key for the admin account (used for privileged operations like pause/unpause/rotation).
# Keep this secure — it provides full control over all four contracts.
ADMIN_SECRET=

# Native XLM token contract address on the target network.
# Testnet:  CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Mainnet:  CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# REQUIRED for initialize.sh (passed to scout_access contract as payment token).
XLM_TOKEN_ADDRESS=

# Target network: testnet | mainnet | local (exact, lowercase; anything else is rejected)
# For local/standalone networks also set NETWORK_PASSPHRASE.
# The backend (src/config.ts) accepts only testnet | mainnet (default: testnet)
# and refuses to start on any other value.
STELLAR_NETWORK=testnet

# Network passphrase. REQUIRED only when STELLAR_NETWORK=local (scripts/network.sh
# exits otherwise). For testnet/mainnet it is set automatically and this value
# is ignored.
# NETWORK_PASSPHRASE="Standalone Network ; February 2017"

# Stellar identity name or secret key used to simulate read-only invocations in
# scripts/health-check.sh, scripts/verify-cross-contract-wiring.sh and
# scripts/full-readiness-check.sh. OPTIONAL — falls back to DEPLOYER_SECRET.
# Keep the value empty or commented out if you rely on the fallback.
# STELLAR_SOURCE_ACCOUNT=

# Directory containing prebuilt release WASM artifacts (scoutchain_<name>.wasm).
# OPTIONAL — scripts/deploy.sh deploys these instead of building from source.
# Default: unset (build from source).
# PREBUILT_WASM_DIR=

# Set to 1 to make scripts/generate-bindings.sh abort on a Stellar CLI version
# mismatch. OPTIONAL — default 0 (warn only).
# STRICT_STELLAR_CLI_VERSION=0

# Stellar Horizon REST API endpoint for the target network.
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for the target network.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# Contract IDs — written to .env.contracts by scripts/deploy.sh.
# Copy these values into the backend and frontend repos after deployment.
# REQUIRED by scripts/initialize.sh, scripts/generate-bindings.sh,
# testnet/seed.sh, and scripts/reconcile-indexer.js.
# =============================================================================

REGISTRATION_CONTRACT_ID=
VERIFICATION_CONTRACT_ID=
PROGRESS_CONTRACT_ID=
SCOUT_ACCESS_CONTRACT_ID=

# =============================================================================
# WASM hashes — written to .env.contracts by scripts/deploy.sh.
# Used to verify on-chain WASM binary identity after deployment.
# =============================================================================

REGISTRATION_CONTRACT_WASM_HASH=
VERIFICATION_CONTRACT_WASM_HASH=
PROGRESS_CONTRACT_WASM_HASH=
SCOUT_ACCESS_CONTRACT_WASM_HASH=

# =============================================================================
# Backend / Node.js — src/app.ts, src/middleware/auth.ts, prisma/schema.prisma,
# scripts/reconcile-indexer.js
# =============================================================================

# HTTP port the backend listens on (src/server.ts). OPTIONAL — default 3000.
# PORT=3000

# Soroban RPC endpoint read by scripts/audit-event-history.js. REQUIRED for that
# script only; typically the same value as SOROBAN_RPC_URL.
# RPC_URL=https://soroban-testnet.stellar.org

# PostgreSQL connection string consumed by Prisma (prisma/schema.prisma) and
# scripts/reconcile-indexer.js for indexer state reads and writes.
# REQUIRED for any backend operation that touches the database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scoutchain

# Secret used to sign and verify JWT tokens (src/config.ts).
# REQUIRED — the server refuses to start without it. Must be >= 32 bytes.
# Use a long random string (e.g. openssl rand -hex 32).
JWT_SECRET=

# SEP-10 Web Authentication
# REQUIRED. Secret key for the server's signing keypair (valid S... secret).
# Used to sign and verify SEP-10 challenge transactions.
SEP10_SIGNING_SECRET=

# REQUIRED. The home domain of the server (e.g. "scoutchain.com").
# Must match the home domain in the client's SEP-10 flow.
# Must be a bare hostname: no scheme (https://), no path (/), no whitespace.
# A port (host:port) or "localhost" is only allowed when STELLAR_NETWORK=testnet.
HOME_DOMAIN=

# REQUIRED. The web authentication domain (e.g. "app.scoutchain.com").
# Used in the challenge transaction's manage_data operation.
# Must be a bare hostname: no scheme (https://), no path (/), no whitespace.
# A port (host:port) or "localhost" is only allowed when STELLAR_NETWORK=testnet.
WEB_AUTH_DOMAIN=

# =============================================================================
# Rate Limiting — src/middleware/rateLimit.ts
# =============================================================================

# When running behind a load balancer or reverse proxy, set this to "true"
# so the server correctly reads the client IP from X-Forwarded-For headers.
# Leave unset or set to "false" when running directly (prevents IP spoofing).
TRUST_PROXY=false

# Rate limits for GET /auth (per IP and per account)
GET_AUTH_IP_LIMIT=10
GET_AUTH_ACCOUNT_LIMIT=5

# Rate limits for POST /auth and POST /auth/refresh (per IP)
POST_AUTH_IP_LIMIT=20
POST_AUTH_REFRESH_IP_LIMIT=10

# Rate limits for admin endpoints (per IP)
ADMIN_IP_LIMIT=10

# Maximum unconsumed SEP-10 challenges per account (older ones are deleted)
MAX_UNCONSUMED_CHALLENGES_PER_ACCOUNT=5

# =============================================================================
# Cleanup Job — src/jobs/cleanup.ts
# =============================================================================

# Interval in seconds between database cleanup runs.
# Set to 0 to disable automatic cleanup (useful for tests).
# For production, 300 (5 minutes) is recommended.
CLEANUP_INTERVAL_SECONDS=300

# =============================================================================
# Logging
# =============================================================================

# Log level for structured logging (pino). Accepts: fatal, error, warn, info,
# debug, trace (default: info).
LOG_LEVEL=info

# =============================================================================
# Metrics
# =============================================================================

# Token to protect the /metrics endpoint. If not set, metrics will be publicly
# accessible. If set, include ?token=<value> or Authorization: Bearer <value>
# in requests to /metrics.
METRICS_TOKEN=

# Optional. URL advertised in /.well-known/stellar.toml. Default: https://<WEB_AUTH_DOMAIN>/auth
WEB_AUTH_ENDPOINT=

# Optional. Comma-separated allow-list of wallet client_domain values. Empty allows any valid hostname.
SEP10_CLIENT_DOMAIN_ALLOWLIST=

# Optional. Timeout in ms for Horizon and client_domain stellar.toml fetches. Default 5000.
SEP10_FETCH_TIMEOUT_MS=5000
