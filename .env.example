# ScoutChain Contracts — environment variables
# Copy to .env and fill in all values before deploying or running the backend.
#
# Variables are grouped by the component that consumes them.
# Required = the scripts / services will exit if the value is absent.
# Optional = a safe default exists or the feature is not exercised on testnet.

# =============================================================================
# Stellar / Soroban — deployment & contract invocation (scripts/deploy.sh,
# scripts/initialize.sh, scripts/generate-bindings.sh, testnet/seed.sh)
# =============================================================================

# Stellar secret key (S...) used to deploy contracts and sign transactions.
# REQUIRED for all deployment and initialization scripts.
DEPLOYER_SECRET=

# Stellar G-address that will be set as admin on all four contracts.
# REQUIRED — ownership cannot be transferred after initialization.
ADMIN_ADDRESS=

# Secret key for the admin account (used for privileged operations like pause/unpause/rotation).
# Keep this secure — it provides full control over all four contracts.
ADMIN_SECRET=

# Native XLM token contract address on the target network.
# Testnet:  CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Mainnet:  CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# REQUIRED for initialize.sh (passed to scout_access contract as payment token).
XLM_TOKEN_ADDRESS=

# Target network: testnet | mainnet (default: testnet)
STELLAR_NETWORK=testnet

# Stellar Horizon REST API endpoint for the target network.
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for the target network.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# =============================================================================
# Contract IDs — written to .env.contracts by scripts/deploy.sh.
# Copy these values into the backend and frontend repos after deployment.
# REQUIRED by scripts/initialize.sh, scripts/generate-bindings.sh,
# testnet/seed.sh, and scripts/reconcile-indexer.js.
# =============================================================================

REGISTRATION_CONTRACT_ID=
VERIFICATION_CONTRACT_ID=
PROGRESS_CONTRACT_ID=
SCOUT_ACCESS_CONTRACT_ID=

# =============================================================================
# WASM hashes — written to .env.contracts by scripts/deploy.sh.
# Used to verify on-chain WASM binary identity after deployment.
# =============================================================================

REGISTRATION_CONTRACT_WASM_HASH=
VERIFICATION_CONTRACT_WASM_HASH=
PROGRESS_CONTRACT_WASM_HASH=
SCOUT_ACCESS_CONTRACT_WASM_HASH=

# =============================================================================
# Backend / Node.js — src/app.ts, src/middleware/auth.ts, prisma/schema.prisma,
# scripts/reconcile-indexer.js
# =============================================================================

# PostgreSQL connection string consumed by Prisma (prisma/schema.prisma) and
# scripts/reconcile-indexer.js for indexer state reads and writes.
# REQUIRED for any backend operation that touches the database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scoutchain

# Secret used by src/middleware/auth.ts to sign and verify JWT tokens.
# REQUIRED — the auth middleware will reject all requests without this.
# Use a long random string (e.g. openssl rand -hex 32).
JWT_SECRET=change-me-before-production

# SEP-10 Web Authentication
# Secret key for the server's signing keypair (S... address).
# Used to sign and verify SEP-10 challenge transactions.
SEP10_SIGNING_SECRET=

# The home domain of the server (e.g. "scoutchain.com").
# Must match the home domain in the client's SEP-10 flow.
HOME_DOMAIN=

# The web authentication domain (e.g. "app.scoutchain.com").
# Used in the challenge transaction's manage_data operation.
WEB_AUTH_DOMAIN=

# Secret key used to sign JWTs issued after successful SEP-10 verification.
JWT_SECRET=
