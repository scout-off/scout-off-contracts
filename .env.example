# ScoutChain Contracts — environment variables
# Copy to .env and fill in values before deploying

# Stellar keypair used to deploy and invoke contracts
DEPLOYER_SECRET=

# Admin G-address that will own all contracts
ADMIN_ADDRESS=

# Native XLM token contract address on the target network
# Testnet:  CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Mainnet:  CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
XLM_TOKEN_ADDRESS=

# Target network: testnet | mainnet
STELLAR_NETWORK=testnet

# Horizon API endpoint
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# SHA-256 hashes of deployed WASM binaries (written by scripts/deploy.sh)
REGISTRATION_CONTRACT_WASM_HASH=
VERIFICATION_CONTRACT_WASM_HASH=
PROGRESS_CONTRACT_WASM_HASH=
SCOUT_ACCESS_CONTRACT_WASM_HASH=

# ---------------------------------------------------------------------------
# JWT authentication (backend API — src/services/sep10.ts)
# ---------------------------------------------------------------------------

# HMAC-SHA256 signing secret for JWTs issued after SEP-10 authentication.
# REQUIRED in production. Use a cryptographically random value of at least
# 32 bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# Token lifetime in seconds (default: 86400 = 24 hours).
# SEP-10 recommends short-lived tokens. Do not set above 86400 in production.
# Example: 3600 for 1 hour, 86400 for 24 hours.
JWT_TTL_SECONDS=86400

# JWT `iss` (issuer) claim — identifies this backend service.
# Must match the value configured in the auth middleware.
# Default: scoutchain-backend
JWT_ISSUER=scoutchain-backend

# JWT `aud` (audience) claim — identifies the intended API consumer.
# Must match the value configured in the auth middleware.
# Default: scoutchain-api
JWT_AUDIENCE=scoutchain-api
