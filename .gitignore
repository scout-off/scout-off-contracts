# Rust / Cargo
target/
# Cargo.lock is tracked for reproducible WASM builds; CI builds with --locked
# Cargo.lock is intentionally tracked for this workspace — see issue #1475.
# WASM contracts are deployable binaries; committing the lockfile ensures that
# every developer and every CI run resolves identical dependency versions and
# produces a reproducible WASM binary hash for release verification.

# Environment secrets -- never commit these
.env
.env.contracts
.env.contracts.json
-.env.contracts.snapshot
.env.local
.env.contracts.json
.env.contracts.snapshot

# Migration state exports (may contain player PII) -- never commit these
migration-export/

# Migration state exports (may contain player PII) -- never commit these
-migration-export/

# Optimized WASM outputs
*.optimized.wasm
*.wasm

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Kiro IDE
.kiro/

# Pull-request drafts
pr-*.md

# ── Node / TypeScript build output ──
# Compiled JS lives in dist/ — never commit it.
dist/
# Compiled test artifacts checked in next to their TS source are forbidden.
# Jest runs from the .ts source via ts-jest; the .js duplicates are noise.
tests/**/*.test.js
tests/**/*.test.js.map
src/**/*.js
src/**/*.js.map

# Node modules and lock files (only package.json is tracked)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Test snapshots ──
# Soroban test runner snapshots
**/test_snapshots/
# Jest / Vitest snapshots
*.snap
*.snap.new
**/__snapshots_/
**/snapshots/

# ── Bindings — generated src/ and compiled dist/ are not committed. ──
# Only package.json and tsconfig.json scaffolds are tracked.
bindings/*/src/
bindings/*/dist/
bindings/*/node_modules/

# ── Temporary / local-only files ──
*.tmp
*.bak
*.orig

# Calibration artifacts (local only)
calibration-report.jsom
budget-drift.json

# Log files
*.log
