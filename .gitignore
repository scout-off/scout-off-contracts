# Rust / Cargo
target/
# Cargo.lock is intentionally tracked for this workspace — see issue #1475.
# WASM contracts are deployable binaries; committing the lockfile ensures that
# every developer and every CI run resolves identical dependency versions and
# produces a reproducible WASM binary hash for release verification.

# Environment secrets -- never commit these
.env
.env.contracts
.env.contracts.json
-.env.contracts.snapshot
.env.local

# Migration state exports (may contain player PII) -- never commit these
-migration-export/

# Optimized WASM outputs
*.optimized.wasm
*.wasm

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Kiro IDE
.kiro/

# Pull-request drafts
pr-*.md

# Test snapshots generated by soroban test runner
*/test_snapshots/

# Root compiled output (tsc outDir) — never commit build artifacts
dist/

# Compiled test outputs — only .ts test sources are tracked; .js twins go stale
# immediately and cause Jest to pick up duplicates.
tests/**/*.test.js
tests/**/*.test.js.map

# Bindings -- generated src/ and compiled dist/ are not committed.
# Only package.json and tsconfig.json scaffolds are tracked.
bindings/*/src/
bindings/*/dist/
bindings/*/node_modules/

# Test snapshots
*.snap
*.snap.new
**/__snapshots_/
**/snapshots/

# Temporary files
*.tmp
*.bak
*.orig

# Node / npm
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Compiled WASM artifacts
*.wasm

# Log files
*.log

# Test snapshots
*.snap
*.snap.new
**/__snapshots_/
**/snapshots/

# Temporary files
*.tmp
*.bak
*.orig

# Calibration artifacts (local only)
calibration-report.jsom
budget-drift.json
