{
  "name": "@scoutchain/bindings-progress",
  "version": "1.1.0",
  "description": "TypeScript client bindings for the ScoutChain progress contract. Auto-generated by `stellar contract bindings typescript` — do not edit by hand.",
  "keywords": ["stellar", "soroban", "scoutchain", "progress"],
  "homepage": "https://github.com/scout-off/scout-off-contracts/tree/main/bindings/progress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scout-off/scout-off-contracts.git",
    "directory": "bindings/progress"
  },
  "bugs": {
    "url": "https://github.com/scout-off/scout-off-contracts/issues"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "tsc --noEmit -p tsconfig.json",
    "test:integration": "vitest run examples",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": false
    }
  }
}
