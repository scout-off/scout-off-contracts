{
  "name": "scoutchain-contracts-tooling",
  "private": true,
  "version": "1.0.0",
  "description": "Node-based tooling for scout-off-contracts (currently just the on-chain/off-chain indexer reconciliation script). Does not affect the Rust contracts or bindings/ packages.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "reconcile-indexer": "node scripts/reconcile-indexer.js",
    "build": "tsc",
    "test": "jest --testPathPattern='src/.*\\.test\\.ts$'"
  },
  "dependencies": {
    "express": "4.18.2",
    "jsonwebtoken": "9.0.2",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.2",
    "jest": "29.7.0",
    "ts-jest": "29.1.5",
    "typescript": "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    }
  }
}
