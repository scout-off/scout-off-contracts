{
  "name": "scoutchain-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Node.js Express API + on-chain/off-chain indexer reconciliation tooling for ScoutChain.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "reconcile-indexer": "node scripts/reconcile-indexer.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "5.16.2",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.11.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.14.15",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.8",
    "jest": "29.7.0",
    "prisma": "5.16.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.3",
    "typescript": "5.5.4"
  }
}
