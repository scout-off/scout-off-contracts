{
  "name": "scoutchain-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Node backend and tooling for ScoutChain contracts.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "reconcile-indexer": "node scripts/reconcile-indexer.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "cleanup": "ts-node src/jobs/cleanup.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "^0.16.1",
    "@stellar/stellar-sdk": "17.4.0",
    "express": "5.3.0",
    "jose": "6.2.18",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.14.15",
    "@types/pino-http": "^5.8.4",
    "@types/pino-pretty": "^4.7.5",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "prisma": "5.16.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.3",
    "typescript": "5.5.4"
  }
}