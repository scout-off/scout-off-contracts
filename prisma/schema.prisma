generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RevokedToken {
  jti       String   @id
  createdAt DateTime @default(now())

  @@map("revoked_tokens")
}

model Sep10Challenge {
  hash       String    @id
  account    String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@map("sep10_challenges")
}

model RefreshToken {
  tokenHash String    @id @map("token_hash")
  account   String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

model Player {
  wallet      String  @unique(map: "idx_players_wallet")
  playerId    BigInt
  age         Int
  position    String
  region      String
  nationality String
  ipfsHashes  String[]
  level       Int    @default(0)
  deactivated Boolean @default(false)
  registeredAt BigInt
  updatedAt   BigInt
  createdAt   DateTime @default(now())
}

model Scout {
  wallet     String  @unique(map: "idx_scouts_wallet")
  region     String
  verified   Boolean @default(false)
  registeredAt BigInt
  createdAt  DateTime @default(now())
}

model Validator {
  wallet      String  @id
  credentials String
  active      Boolean @default(true)
  registeredAt BigInt
  createdAt   DateTime @default(now())
}

model Admin {
  address   String  @id
  createdAt DateTime @default(now())
}
